# Kopiere diese Datei nach .streamlit/secrets.toml (lokal) oder trage die
# Werte im Streamlit Cloud Dashboard unter "Secrets" ein. Diese Datei selbst
# NICHT committen (steht in .gitignore).

DISCOGS_TOKEN = "your_discogs_token_here"
DISCOGS_USERNAME = "your_discogs_username_here"
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your_supabase_key_here"
APP_PASSWORD = "change_me"
