# Copy this file to .streamlit/secrets.toml (local) or enter the values
# in the Streamlit Cloud dashboard under "Secrets". Do NOT commit this
# file itself (it's in .gitignore).

DISCOGS_TOKEN = "your_discogs_token_here"
DISCOGS_USERNAME = "your_discogs_username_here"
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your_supabase_key_here"
APP_PASSWORD = "change_me"
