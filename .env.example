# Discogs: get a Personal Access Token at
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_discogs_token_here
DISCOGS_USERNAME=your_discogs_username_here

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# Password protection for the Streamlit app
APP_PASSWORD=change_me
